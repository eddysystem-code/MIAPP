<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis Gastos"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="15dp" />

    <EditText
        android:id="@+id/nombreGasto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del gasto"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/valorGasto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor del gasto"
        android:inputType="number" />

    <Button
        android:id="@+id/botonAgregar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregar gasto" />

    <TextView
        android:id="@+id/listaGastos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textSize="16sp"
        android:padding="10dp"
        android:textColor="#222222" />

    <TextView
        android:id="@+id/totalGastos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total gastado: $0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="15dp" />

</LinearLayout>